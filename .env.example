# Copy to .env for local overrides. Docker Compose also reads this file.

# --- Application ---
FORGEFLOW_ENVIRONMENT=development
FORGEFLOW_LOG_LEVEL=INFO
FORGEFLOW_LOG_JSON=true
FORGEFLOW_API_PREFIX=/api/v1

# --- PostgreSQL (used by Compose and the API) ---
POSTGRES_USER=forgeflow
POSTGRES_PASSWORD=forgeflow
POSTGRES_DB=forgeflow
POSTGRES_PORT=5432

# SQLAlchemy async URL. Host is "postgres" inside Compose and "localhost" on the host.
DATABASE_URL=postgresql+asyncpg://forgeflow:forgeflow@localhost:5432/forgeflow

# --- LLM provider ---
# mock: in-process, used by tests. ollama: local models. openai: cloud (requires LLM_API_KEY).
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Investigation clock for the synthetic plant. Unset to use the process clock.
FORGEFLOW_AS_OF=2026-09-03T12:00:00+00:00
MCP_TOOL_TIMEOUT_SECONDS=15

# memory: in-process LangGraph checkpoints (tests). postgres: durable interrupt/resume.
CHECKPOINT_BACKEND=memory
